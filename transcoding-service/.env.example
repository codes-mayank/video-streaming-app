AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_BUCKET_NAME=videos

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_VIDEO_TOPIC=video-transcode-jobs
KAFKA_CONSUMER_GROUP=video-transcoder-group
# Local Docker: PLAINTEXT. Confluent Cloud:
# KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.<region>.aws.confluent.cloud:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=<API_KEY>
# KAFKA_SASL_PASSWORD=<API_SECRET>
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Idle wait before the Job exits when the queue is empty (ms)
KAFKA_CONSUMER_TIMEOUT_MS=15000
# Must exceed longest expected transcode (ms); default 2 hours
KAFKA_MAX_POLL_INTERVAL_MS=7200000

# Azure Container Apps Job: messages to process per execution, then exit
MAX_MESSAGES_PER_RUN=1
# Set true to skip retries for permanently failing videos
COMMIT_ON_FAILURE=false

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Optional: defaults to the OS temp dir (e.g. /tmp on Linux, $TMPDIR on macOS)
# TRANSCODE_WORKDIR=/var/folders/.../video-transcoder
HLS_SEGMENT_SECONDS=4

# Use a URL reachable from Azure (not localhost) when deployed
VIDEO_SERVICE_BASE_URL=http://127.0.0.1:8000
VIDEO_SERVICE_TIMEOUT_SECONDS=120
