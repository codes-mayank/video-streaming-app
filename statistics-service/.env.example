# Must point at the same database used by video-service (shared tables).
DATABASE_URL=postgresql+psycopg2://mayank:root@localhost/video_stream_app

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SUBSCRIPTION_EVENTS_TOPIC=subscription-events
KAFKA_ENGAGEMENT_EVENTS_TOPIC=engagement-events
KAFKA_CONSUMER_GROUP=statistics-service-group
KAFKA_ENGAGEMENT_CONSUMER_GROUP=statistics-engagement-group
# Local Docker: PLAINTEXT. Confluent Cloud:
# KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.<region>.aws.confluent.cloud:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=<API_KEY>
# KAFKA_SASL_PASSWORD=<API_SECRET>
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Subscription batching
SUBSCRIPTION_BATCH_SIZE=50
SUBSCRIPTION_BATCH_FLUSH_SECONDS=5
SUBSCRIPTION_POLL_TIMEOUT_MS=1000

# Engagement batching (likes, comments, views)
ENGAGEMENT_BATCH_SIZE=50
ENGAGEMENT_BATCH_FLUSH_SECONDS=5
ENGAGEMENT_POLL_TIMEOUT_MS=1000

# Exit process when both consumers stay idle for N poll cycles.
STATS_EXIT_ON_IDLE=true
STATS_MAX_IDLE_POLLS=10

# Same Redis used by video-service (optional; counters sync is skipped if unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
