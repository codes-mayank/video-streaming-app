# Copy to .env and fill in real upstream URLs (never commit .env).
#
# Public clients call https://wetubevideo.tech/api/... ; Cloudflare strips /api
# and forwards /users/... and /videos/... to this gateway.
#
# Azure Container Apps example:
# AUTH_UPSTREAM=https://auth-service.<env>.<region>.azurecontainerapps.io
# VIDEO_UPSTREAM=https://video-service.<env>.<region>.azurecontainerapps.io
#
# Local Docker network example:
# AUTH_UPSTREAM=http://auth-service:8000
# VIDEO_UPSTREAM=http://video-service:8001

AUTH_UPSTREAM=https://auth-service.example.com
VIDEO_UPSTREAM=https://video-service.example.com
