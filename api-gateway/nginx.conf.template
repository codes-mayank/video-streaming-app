events {}

http {
    client_max_body_size 2G;

    server {
        listen 80;
        server_name _;

        location = /health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        # Frontend calls /users/auth/... ; auth-service mounts routes at /auth/...
        location /users/ {
            proxy_pass ${AUTH_UPSTREAM}/;
            proxy_http_version 1.1;
            proxy_set_header Host ${AUTH_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_ssl_server_name on;
            proxy_ssl_name ${AUTH_HOST};
            proxy_connect_timeout 60s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
        }

        location = /videos {
            proxy_pass ${VIDEO_UPSTREAM}/videos;
            proxy_http_version 1.1;
            proxy_set_header Host ${VIDEO_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_ssl_server_name on;
            proxy_ssl_name ${VIDEO_HOST};
            proxy_connect_timeout 60s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
        }

        # Keep /videos prefix — video-service mounts routes at /videos/...
        location /videos/ {
            proxy_pass ${VIDEO_UPSTREAM}/videos/;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_set_header Host ${VIDEO_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_ssl_server_name on;
            proxy_ssl_name ${VIDEO_HOST};
            proxy_connect_timeout 60s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
        }
    }
}
