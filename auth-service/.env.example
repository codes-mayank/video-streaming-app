GOOGLE_CLIENT_ID=your-google-client-id
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_BUCKET_NAME=videos
DATABASE_URL=postgresql+psycopg2://user:pass@localhost/video_stream_app
SECRET_KEY=secret-key

# Include your deployed frontend origin (required for signup/login from that site).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# When frontend and API are on different domains:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
